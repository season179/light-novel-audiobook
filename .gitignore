# Project work products and large assets
/work/
/data/
/models/
/output/
/evaluation/
/evaluation-private/
# Real source books live here and are never committed, whatever their extension.
# The whole directory is ignored so a non-.epub container (.kepub, .azw3, .zip) or an
# unpacked directory cannot slip past the extension rules below.
/ebooks/
*.epub
*.gguf
*.ggml
*.safetensors
*.wav
*.flac
*.mp3
*.m4a
*.m4b
*.aac
*.opus

# Small, intentionally committed test fixtures are allowed
!tests/fixtures/**/*.epub
!tests/fixtures/**/*.wav
!tests/fixtures/**/*.flac
!tests/fixtures/**/*.mp3
