{
  "name": "@light-novel-audiobook/qwen-tts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "python3 -m py_compile python/qwen_batch_worker.py && python3 -m unittest discover -s test -p 'qwen_batch_worker_test.py' && vitest run --root ../.. packages/qwen-tts/test",
    "smoke:real": "tsx scripts/real-smoke.ts"
  },
  "dependencies": {
    "@light-novel-audiobook/application": "workspace:*",
    "@light-novel-audiobook/domain": "workspace:*",
    "@light-novel-audiobook/gpu-lease": "workspace:*"
  },
  "devDependencies": {
    "@light-novel-audiobook/persistence": "workspace:*",
    "tsx": "4.21.0"
  }
}
