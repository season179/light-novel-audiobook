{
  "$id": "https://local.invalid/light-novel-audiobook/evaluation/evaluation-run@2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "evaluation-run@2"
    },
    "run_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_schema_version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
        },
        "output_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "context_size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "model_id",
        "model_sha256",
        "prompt_version",
        "prompt_sha256",
        "output_schema_version",
        "output_schema_sha256",
        "seed",
        "context_size",
        "parameters"
      ],
      "additionalProperties": false
    },
    "operational": {
      "type": "object",
      "properties": {
        "resource_measurement": {
          "type": "object",
          "properties": {
            "method_version": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
            },
            "collector_id": {
              "type": "string",
              "minLength": 1
            },
            "collector_version": {
              "type": "string",
              "minLength": 1
            },
            "elapsed_scope": {
              "type": "string",
              "const": "complete-direction-run"
            },
            "memory_unit": {
              "type": "string",
              "const": "mebibyte"
            }
          },
          "required": [
            "method_version",
            "collector_id",
            "collector_version",
            "elapsed_scope",
            "memory_unit"
          ],
          "additionalProperties": false
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "peak_vram_mib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "peak_ram_mib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crashed": {
          "type": "boolean"
        },
        "out_of_memory": {
          "type": "boolean"
        }
      },
      "required": [
        "resource_measurement",
        "elapsed_ms",
        "peak_vram_mib",
        "peak_ram_mib",
        "crashed",
        "out_of_memory"
      ],
      "additionalProperties": false
    },
    "predictions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "source_start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source_end": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "string",
                "const": "predicted"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": ["narration", "dialogue", "thought", "message", "sound_cue"]
              },
              "speaker": {
                "type": "string",
                "minLength": 1
              },
              "review_required": {
                "type": "boolean"
              }
            },
            "required": [
              "source_ref",
              "source_start",
              "source_end",
              "status",
              "text",
              "kind",
              "speaker",
              "review_required"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "source_start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source_end": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "string",
                "const": "refused"
              },
              "refusal_code": {
                "type": "string",
                "enum": ["policy", "content", "other"]
              },
              "review_required": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "source_ref",
              "source_start",
              "source_end",
              "status",
              "refusal_code",
              "review_required"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_index",
    "source_sha256",
    "corpus_sha256",
    "model",
    "operational",
    "predictions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
