{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/light-novel-audiobook/segment.schema.json",
  "title": "Audiobook segment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chapter",
    "segment_id",
    "kind",
    "speaker",
    "voice",
    "text",
    "confidence",
    "pause_after_ms"
  ],
  "properties": {
    "chapter": { "type": "integer", "minimum": 1 },
    "segment_id": { "type": "string", "pattern": "^ch[0-9]+-[0-9]+$" },
    "kind": {
      "type": "string",
      "enum": ["narration", "dialogue", "thought", "message", "sound_cue"]
    },
    "speaker": { "type": "string", "minLength": 1 },
    "voice": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "emotion": { "type": "string", "default": "neutral" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "pause_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "review_required": { "type": "boolean", "default": false },
    "source_start": { "type": "integer", "minimum": 0 },
    "source_end": { "type": "integer", "minimum": 0 }
  }
}
