{
  "name": "light-novel-audiobook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "preinstall": "node scripts/preflight-toolchain.mjs",
    "postinstall": "node scripts/preflight-toolchain.mjs --dependencies",
    "preflight": "node scripts/preflight-toolchain.mjs --dependencies",
    "verify:toolchain": "node scripts/verify-toolchain-config.mjs",
    "probe:topology": "node scripts/probe-topology.mjs",
    "test:topology": "node --test scripts/test/topology.test.mjs",
    "voxcpm2:verify": "bash scripts/voxcpm2-spike.sh verify",
    "voxcpm2:setup": "bash scripts/voxcpm2-spike.sh setup",
    "voxcpm2:probe": "bash scripts/voxcpm2-spike.sh probe",
    "test:voxcpm2": "node --test scripts/test/voxcpm2-spike.test.mjs",
    "voices:verify": "bash scripts/synthetic-voice-bootstrap.sh verify",
    "voices:setup": "bash scripts/synthetic-voice-bootstrap.sh setup",
    "voices:probe": "bash scripts/synthetic-voice-bootstrap.sh probe",
    "test:voices": "node --test scripts/test/synthetic-voice-bootstrap.test.mjs",
    "dev": "pnpm dev:direct",
    "dev:direct": "pnpm --parallel --filter @light-novel-audiobook/web --filter @light-novel-audiobook/worker dev",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm verify:toolchain && pnpm --recursive typecheck",
    "test": "pnpm test:toolchain && pnpm test:topology && pnpm test:voxcpm2 && pnpm test:voices && vitest run",
    "test:toolchain": "node --test scripts/test/preflight-toolchain.test.mjs && bash scripts/test/install-wsl-toolchain.test.sh",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm preflight && biome check . && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsx": "4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
