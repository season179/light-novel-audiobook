{
  "name": "light-novel-audiobook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "preinstall": "node scripts/preflight-toolchain.mjs",
    "postinstall": "node scripts/preflight-toolchain.mjs --dependencies",
    "preflight": "node scripts/preflight-toolchain.mjs --dependencies",
    "verify:toolchain": "node scripts/verify-toolchain-config.mjs",
    "dev": "pnpm dev:direct",
    "dev:direct": "pnpm --parallel --filter @light-novel-audiobook/web --filter @light-novel-audiobook/worker dev",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm verify:toolchain && pnpm --recursive typecheck",
    "test": "pnpm test:toolchain && vitest run",
    "test:toolchain": "node --test scripts/test/*.test.mjs && bash scripts/test/install-wsl-toolchain.test.sh",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm preflight && biome check . && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "portless": "0.15.4",
    "tsx": "4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
